{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "速启",
  "version": "0.1.0",
  "identifier": "com.suqi.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "速启",
      "width": 980,
      "height": 680,
      "minWidth": 700,
      "minHeight": 500,
      "resizable": true
    }, {
      "label": "settings",
      "title": "速启设置",
      "url": "settings.html",
      "width": 720,
      "height": 560,
      "minWidth": 480,
      "minHeight": 400,
      "resizable": true,
      "visible": false
    }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}
